<Window x:Class="WpfApp3.UI.Admin.AdminPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navlan — Admin Panel"
        Height="700" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <DockPanel>
                <TextBlock Text="⚙ Admin Panel"
                           FontSize="18" FontWeight="Bold"
                           FontFamily="Segoe UI"
                           Foreground="{DynamicResource PrimaryText}"
                           VerticalAlignment="Center"/>
                <Button Content="✕ Close"
                        DockPanel.Dock="Right"
                        Height="32" Padding="14,0"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        BorderThickness="0" Cursor="Hand"
                        Click="CloseButton_Click"
                        FontFamily="Segoe UI"/>
                <Button Content="⟳ Refresh"
                        DockPanel.Dock="Right"
                        Height="32" Padding="14,0"
                        Margin="0,0,8,0"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        BorderThickness="0" Cursor="Hand"
                        Click="RefreshButton_Click"
                        FontFamily="Segoe UI"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: User/Device list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Authorized Devices"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,8"/>

                <ListView x:Name="DeviceListView"
                          Grid.Row="1"
                          Background="{DynamicResource CardBackground}"
                          BorderBrush="{DynamicResource CardBorder}"
                          BorderThickness="1"
                          FontFamily="Segoe UI"
                          FontSize="12"
                          SelectionChanged="DeviceListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Device ID"   Width="120"
                                            DisplayMemberBinding="{Binding DeviceId}"/>
                            <GridViewColumn Header="Username"    Width="100"
                                            DisplayMemberBinding="{Binding Username}"/>
                            <GridViewColumn Header="Role"        Width="70"
                                            DisplayMemberBinding="{Binding Role}"/>
                            <GridViewColumn Header="Status"      Width="80"
                                            DisplayMemberBinding="{Binding StatusText}"/>
                            <GridViewColumn Header="Last Seen"   Width="140"
                                            DisplayMemberBinding="{Binding LastSeenText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- Right: Create user form + actions -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Create User -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Create User"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="Username"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,3"/>
                        <TextBox x:Name="NewUsernameBox"
                                 Background="{DynamicResource InputBackground}"
                                 Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorder}"
                                 BorderThickness="1" Padding="8,5"
                                 Margin="0,0,0,8" FontSize="12" FontFamily="Segoe UI"/>

                        <TextBlock Text="Device ID (e.g. NAV-ABCD1234)"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,3"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="Generate"
                                    DockPanel.Dock="Right"
                                    Padding="8,0"
                                    Background="{DynamicResource ButtonBackground}"
                                    Foreground="{DynamicResource ButtonForeground}"
                                    BorderThickness="0" Cursor="Hand"
                                    FontSize="11" FontFamily="Segoe UI"
                                    Click="GenerateDeviceId_Click"/>
                            <TextBox x:Name="NewDeviceIdBox"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource InputForeground}"
                                     BorderBrush="{DynamicResource InputBorder}"
                                     BorderThickness="1" Padding="8,5"
                                     FontSize="12" FontFamily="Consolas"
                                     Margin="0,0,4,0"/>
                        </DockPanel>

                        <TextBlock Text="Initial Password"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,3"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Background="{DynamicResource InputBackground}"
                                     Foreground="{DynamicResource InputForeground}"
                                     BorderBrush="{DynamicResource InputBorder}"
                                     BorderThickness="1" Padding="8,5"
                                     Margin="0,0,0,12" FontSize="12" FontFamily="Segoe UI"/>

                        <TextBlock x:Name="CreateResultText"
                                   Foreground="{DynamicResource SuccessColor}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,8"/>

                        <Button x:Name="CreateUserButton"
                                Content="Create User"
                                Height="34"
                                Background="{DynamicResource AccentColor}"
                                Foreground="White"
                                FontSize="12" FontWeight="SemiBold"
                                FontFamily="Segoe UI"
                                BorderThickness="0" Cursor="Hand"
                                Click="CreateUserButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="5"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Device actions -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1" CornerRadius="6"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Device Actions"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="SelectedDeviceText"
                                   Text="— select a device —"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,10"/>

                        <TextBlock x:Name="ActionResultText"
                                   Foreground="{DynamicResource SuccessColor}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,0,0,8"/>

                        <WrapPanel>
                            <Button x:Name="EnableBtn"   Content="Enable"      IsEnabled="False"
                                    Height="30" Padding="10,0" Margin="0,0,6,6"
                                    Background="{DynamicResource SuccessColor}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI"
                                    Click="EnableBtn_Click"/>
                            <Button x:Name="DisableBtn"  Content="Disable"     IsEnabled="False"
                                    Height="30" Padding="10,0" Margin="0,0,6,6"
                                    Background="{DynamicResource WarnColor}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI"
                                    Click="DisableBtn_Click"/>
                            <Button x:Name="RevokeBtn"   Content="Revoke"      IsEnabled="False"
                                    Height="30" Padding="10,0" Margin="0,0,6,6"
                                    Background="{DynamicResource DangerColor}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI"
                                    Click="RevokeBtn_Click"/>
                            <Button x:Name="ResetBtn"    Content="Reset Access" IsEnabled="False"
                                    Height="30" Padding="10,0" Margin="0,0,0,6"
                                    Background="{DynamicResource ButtonBackground}"
                                    Foreground="{DynamicResource ButtonForeground}"
                                    BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI"
                                    Click="ResetBtn_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
