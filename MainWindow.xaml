<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chat="clr-namespace:WpfApp3.UI.Chat"
        Title="Navlan"
        Width="1020"
        Height="640"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        x:Name="RootWindow">

    <Window.Resources>

        <!-- LIGHT MODE BRUSHES (defaults) -->
        <SolidColorBrush x:Key="AppBg"         Color="#E8ECEC"/>
        <SolidColorBrush x:Key="SidebarBg"     Color="#DADEDF"/>
        <SolidColorBrush x:Key="PanelBg"       Color="#E2E6E7"/>
        <SolidColorBrush x:Key="PanelBorder"   Color="#C9D0D2"/>
        <SolidColorBrush x:Key="InputBg"       Color="#EAEEEF"/>
        <SolidColorBrush x:Key="InputBorder"   Color="#BFC8CA"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#1C2B30"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#4A6570"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#8A9FA8"/>
        <SolidColorBrush x:Key="Accent"        Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentHover"   Color="#1A252F"/>
        <SolidColorBrush x:Key="ActiveNav"     Color="#2C3E50"/>
        <SolidColorBrush x:Key="NavHover"      Color="#C5CBCC"/>

        <!-- NAV BUTTON -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="Foreground"                Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="Padding"                   Value="18,11"/>
            <Setter Property="FontSize"                  Value="13"/>
            <Setter Property="FontFamily"                Value="Segoe UI"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background"
                                        Value="{StaticResource NavHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background"  Value="{StaticResource ActiveNav}"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

        <!-- ACTION BUTTON -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource Accent}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#AABCC3"/>
                                <Setter Property="Foreground"                 Value="#E5EFF2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- INLINE BUTTON -->
        <Style x:Key="InlineButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#AABCC3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PROGRESS BAR -->
        <Style x:Key="NavProgressBar" TargetType="ProgressBar">
            <Setter Property="Height"     Value="8"/>
            <Setter Property="Background" Value="#C5CBCC"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Height="{TemplateBinding Height}">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- LIST BOX -->
        <Style x:Key="DeviceListStyle" TargetType="ListBox">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding"   Value="10,8"/>
            <Setter Property="Margin"    Value="0,2"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize"  Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{StaticResource NavHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background"
                                        Value="{StaticResource ActiveNav}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- THEME TOGGLE -->
        <Style x:Key="ThemeToggle" TargetType="ToggleButton">
            <Setter Property="Background"      Value="#2C3E50"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A5568"/>
                                <Setter Property="Foreground"                 Value="#F6E05E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ROOT -->
    <Border x:Name="RootBorder" Background="{StaticResource AppBg}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =========================================================
                 SIDEBAR
                 ========================================================= -->
            <Border Grid.Column="0"
                    x:Name="SidebarBorder"
                    Background="{StaticResource SidebarBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <Border Grid.Row="0" Padding="20,22,20,18">
                        <Image Source="navlan_logo.png"
                               Width="100"
                               HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Row="1" Margin="10,0">
                        <Button x:Name="NavHome"
                                Content="🏠 Home"
                                Style="{StaticResource NavButtonActive}"
                                Margin="0,2"
                                Click="NavHome_Click"/>
                        <Button x:Name="NavHistory"
                                Content="📋 History"
                                Style="{StaticResource NavButton}"
                                Margin="0,2"
                                Click="NavHistory_Click"/>
                        <Button x:Name="NavKnownDevices"
                                Content="📡 Known Devices"
                                Style="{StaticResource NavButton}"
                                Margin="0,2"
                                Click="NavKnownDevices_Click"/>
                        <Button x:Name="NavAuthDevice"
                                Content="🔐 Auth Device"
                                Style="{StaticResource NavButton}"
                                Margin="0,2"
                                Click="NavAuthDevice_Click"/>
                        <Button x:Name="NavChat"
                                Content="💬 Chat"
                                Style="{StaticResource NavButton}"
                                Margin="0,2"
                                Click="NavChat_Click"/>
                        <Button x:Name="NavSettings"
                                Content="⚙ Settings"
                                Style="{StaticResource NavButton}"
                                Margin="0,2"
                                Click="NavSettings_Click"/>
                        <!-- Admin only -->
                        <Button x:Name="NavAdmin"
                                Content="🛡 Admin Panel"
                                Style="{StaticResource NavButton}"
                                Margin="0,2"
                                Visibility="Collapsed"
                                Click="NavAdmin_Click"/>
                    </StackPanel>

                    <!-- Bottom: Account info + theme + logout -->
                    <Border Grid.Row="2" Padding="12,10">
                        <StackPanel>
                            <!-- Account info -->
                            <Border Background="#0A0F00"
                                    Opacity="0.15"
                                    CornerRadius="8"
                                    Margin="0,0,0,8"
                                    Padding="10,8">
                                <StackPanel>
                                    <TextBlock x:Name="AccountUsernameText"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="Segoe UI"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AccountDeviceIdText"
                                               FontSize="10" FontFamily="Consolas"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0"/>
                                    <TextBlock x:Name="AccountRoleText"
                                               FontSize="10" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>
                            <!-- Theme toggle -->
                            <ToggleButton x:Name="ThemeToggleBtn"
                                          Style="{StaticResource ThemeToggle}"
                                          Content="&#x1F319; Dark Mode"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,0,6"
                                          Checked="ThemeToggleBtn_Checked"
                                          Unchecked="ThemeToggleBtn_Unchecked"/>
                            <!-- Logout -->
                            <Button Content="⏏ Logout"
                                    Style="{StaticResource NavButton}"
                                    HorizontalAlignment="Stretch"
                                    Click="LogoutButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Divider -->
            <Border Grid.Column="1" Background="{StaticResource PanelBorder}"/>

            <!-- =========================================================
                 CONTENT AREA
                 ========================================================= -->
            <Grid Grid.Column="2">

                <!-- =====================================================
                     HOME PAGE
                     ===================================================== -->
                <Border x:Name="PageHome" Visibility="Visible" Padding="28,22,28,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title + status -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Send File"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Searching for nearby devices..."
                                       FontSize="12"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Main compose panel -->
                        <Border Grid.Row="1"
                                Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="14"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- TO -->
                                <Border Grid.Row="0"
                                        BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="To"
                                                Style="{StaticResource InlineButton}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False"/>
                                        <ComboBox x:Name="RecipientCombo"
                                                  Grid.Column="1"
                                                  Height="30"
                                                  Margin="6,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Background="{StaticResource InputBg}"
                                                  BorderBrush="{StaticResource InputBorder}"
                                                  FontFamily="Segoe UI"
                                                  FontSize="13"
                                                  Foreground="{StaticResource TextPrimary}"
                                                  SelectionChanged="RecipientCombo_SelectionChanged"/>
                                    </Grid>
                                </Border>

                                <!-- SELECT FILE -->
                                <Border Grid.Row="1"
                                        BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SelectFileButton"
                                                Grid.Column="0"
                                                Content="Select File"
                                                Style="{StaticResource InlineButton}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Click="SelectFileButton_Click"/>
                                        <TextBlock x:Name="SelectedFileText"
                                                   Grid.Column="1"
                                                   Text="No file selected"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <!-- SUBJECT -->
                                <Border Grid.Row="2"
                                        BorderBrush="{StaticResource PanelBorder}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="Subject"
                                                Style="{StaticResource InlineButton}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False"/>
                                        <TextBox x:Name="SubjectTextBox"
                                                 Grid.Column="1"
                                                 Height="28"
                                                 Margin="6,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontFamily="Segoe UI"
                                                 FontSize="13"
                                                 Foreground="{StaticResource TextPrimary}"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- MESSAGE area with watermark -->
                                <Grid Grid.Row="3" ClipToBounds="True">
                                    <!-- Watermark -->
                                    <Image Source="navlan_logo.png"
                                           Width="200"
                                           Opacity="0.12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           IsHitTestVisible="False"/>
                                    <!-- Label -->
                                    <Button Content="Message"
                                            Style="{StaticResource InlineButton}"
                                            Margin="12,10,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False"/>
                                    <!-- Input -->
                                    <TextBox x:Name="MessageTextBox"
                                             Margin="12,46,12,12"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Segoe UI"
                                             FontSize="13"
                                             Foreground="{StaticResource TextPrimary}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             VerticalContentAlignment="Top"/>
                                </Grid>

                            </Grid>
                        </Border>

                        <!-- Bottom: progress + send -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Progress"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <ProgressBar x:Name="TransferProgress"
                                         Grid.Column="1"
                                         Style="{StaticResource NavProgressBar}"
                                         Minimum="0" Maximum="100" Value="0"
                                         VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProgressText"
                                       Grid.Column="2"
                                       Text="0%"
                                       FontFamily="Segoe UI"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,14,0"/>
                            <Button x:Name="SendButton"
                                    Grid.Column="3"
                                    Content="Send"
                                    Width="88"
                                    Height="34"
                                    Style="{StaticResource ActionButton}"
                                    IsEnabled="False"
                                    Click="SendButton_Click"/>
                        </Grid>

                    </Grid>
                </Border>

                <!-- =====================================================
                     KNOWN DEVICES PAGE
                     ===================================================== -->
                <Border x:Name="PageKnownDevices" Visibility="Collapsed" Padding="28,22,28,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Known Devices"
                                       FontSize="20" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Devices discovered on your network"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10">
                            <ListBox x:Name="DevicesList"
                                     Style="{StaticResource DeviceListStyle}"
                                     SelectionChanged="DevicesList_SelectionChanged"/>
                        </Border>

                        <!-- Pairing strip -->
                        <Border Grid.Row="2"
                                Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="DEVICE TRUST"
                                               FontSize="10" FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock x:Name="PairingStatusText"
                                               Text="Select a device"
                                               FontSize="12" FontFamily="Segoe UI"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="PairButton"
                                            Content="Pair"
                                            Width="76" Height="30"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource ActionButton}"
                                            IsEnabled="False"/>
                                    <Button x:Name="UnpairButton"
                                            Content="Unpair"
                                            Width="76" Height="30"
                                            Style="{StaticResource InlineButton}"
                                            IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- =====================================================
                     AUTHENTICATE DEVICE PAGE
                     ===================================================== -->
                <Border x:Name="PageAuthDevice" Visibility="Collapsed" Padding="28,22,28,18">
                    <StackPanel>
                        <TextBlock Text="Authenticate Device"
                                   FontSize="20" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Pair or unpair devices for secure file transfer."
                                   FontSize="12" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,0,0,18"/>
                        <Border Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI" FontSize="13"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap">
                                    Select a device from <Bold>Known Devices</Bold>, then use
                                    <Bold>Pair</Bold> / <Bold>Unpair</Bold> to manage trust.
                                </TextBlock>
                                <TextBlock Text="Security features:"
                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,16,0,6"/>
                                <TextBlock Text="• TLS 1.3 / 1.2 encrypted transport"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Text="• Mutual certificate authentication"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Text="• Pinned certificate fingerprints"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                                <TextBlock Text="• SHA-256 file integrity verification"
                                           FontFamily="Segoe UI" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- =====================================================
                     HISTORY PAGE
                     ===================================================== -->
                <Border x:Name="PageHistory" Visibility="Collapsed" Padding="28,22,28,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Transfer History"
                                       FontSize="20" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Recent file transfers"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1"
                                Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="12" Padding="10">
                            <ListBox x:Name="HistoryList"
                                     Style="{StaticResource DeviceListStyle}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- =====================================================
                     SETTINGS PAGE
                     ===================================================== -->
                <Border x:Name="PageSettings" Visibility="Collapsed" Padding="28,22,28,18">
                    <StackPanel>
                        <TextBlock Text="Settings"
                                   FontSize="20" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Application preferences"
                                   FontSize="12" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="0,0,0,18"/>
                        <Border Background="{StaticResource PanelBg}"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Device Name"
                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,0,0,6"/>
                                <TextBox x:Name="DeviceNameBox"
                                         Height="34"
                                         Background="{StaticResource InputBg}"
                                         BorderBrush="{StaticResource InputBorder}"
                                         BorderThickness="1"
                                         Padding="10,0"
                                         FontFamily="Segoe UI" FontSize="13"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock Text="Appearance"
                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           Margin="0,20,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Dark Mode"
                                               FontFamily="Segoe UI" FontSize="13"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <ToggleButton x:Name="ThemeToggleSettings"
                                                  Style="{StaticResource ThemeToggle}"
                                                  Content="Off"
                                                  Checked="ThemeToggleBtn_Checked"
                                                  Unchecked="ThemeToggleBtn_Unchecked"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- =====================================================
                     CHAT PAGE
                     ===================================================== -->
                <Border x:Name="PageChatContainer" Visibility="Collapsed">
                    <chat:BroadcastChatPanel x:Name="ChatPanelControl"/>
                </Border>

            </Grid>
        </Grid>
    </Border>

</Window>