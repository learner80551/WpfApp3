<Window x:Class="WpfApp3.TransferRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming File"
        Height="300"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Incoming File"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="A device wants to send you:"
                       FontSize="16"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="SenderText"
                       FontSize="15"
                       Margin="0,5"/>

            <TextBlock x:Name="FileNameText"
                       FontSize="15"
                       Margin="0,5"/>

            <TextBlock x:Name="FileSizeText"
                       FontSize="15"
                       Margin="0,5"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Accept"
                    Width="120"
                    Height="40"
                    Margin="10"
                    Click="AcceptButton_Click"/>

            <Button Content="Reject"
                    Width="120"
                    Height="40"
                    Margin="10"
                    Click="RejectButton_Click"/>

        </StackPanel>

    </Grid>
</Window>
    