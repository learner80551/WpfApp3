<Window x:Class="WpfApp3.UI.Settings.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navlan — Change Password"
        Height="400" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="36,28,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Change Password"
                       FontSize="18" FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource PrimaryText}"/>
            <TextBlock Text="Choose a new password for your account."
                       FontSize="12" FontFamily="Segoe UI"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Current Password"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="CurrentPasswordBox"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1" Padding="10,8"
                         FontSize="13" FontFamily="Segoe UI"
                         Margin="0,0,0,14"/>

            <TextBlock Text="New Password (min 8 characters)"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="NewPasswordBox"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1" Padding="10,8"
                         FontSize="13" FontFamily="Segoe UI"
                         Margin="0,0,0,14"/>

            <TextBlock Text="Confirm New Password"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1" Padding="10,8"
                         FontSize="13" FontFamily="Segoe UI"
                         Margin="0,0,0,4"/>

            <TextBlock x:Name="ResultText"
                       FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerColor}"
                       Visibility="Collapsed"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="80" Height="34" Margin="0,0,8,0"
                    Background="{DynamicResource ButtonBackground}"
                    Foreground="{DynamicResource ButtonForeground}"
                    BorderThickness="0" Cursor="Hand"
                    FontFamily="Segoe UI"
                    Click="CancelButton_Click"/>
            <Button x:Name="SaveButton"
                    Content="Save"
                    Width="80" Height="34"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White"
                    FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"
                    FontFamily="Segoe UI"
                    Click="SaveButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="5"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
