<Window x:Class="WpfApp3.UI.Login.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navlan — First-Run Setup"
        Height="580" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Grid Margin="48,32,48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <Image Source="/navlan_logo.png" Width="56" Height="56"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,0,0,12"/>
            <TextBlock Text="Welcome to Navlan"
                       FontSize="22" FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource PrimaryText}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Create the administrator account to get started."
                       FontSize="12"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource SecondaryText}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- Form -->
        <StackPanel Grid.Row="1">

            <!-- Admin username -->
            <TextBlock Text="Admin Username"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="AdminUsernameBox"
                     FontSize="13" FontFamily="Segoe UI"
                     Background="{DynamicResource InputBackground}"
                     Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"
                     BorderThickness="1"
                     Padding="12,8"
                     Margin="0,0,0,14"/>

            <!-- Password -->
            <TextBlock Text="Admin Password (min 8 characters)"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="AdminPasswordBox"
                         FontSize="13" FontFamily="Segoe UI"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1"
                         Padding="12,8"
                         Margin="0,0,0,14"/>

            <!-- Confirm Password -->
            <TextBlock Text="Confirm Password"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         FontSize="13" FontFamily="Segoe UI"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1"
                         Padding="12,8"
                         Margin="0,0,0,4"/>

            <!-- Error -->
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource DangerColor}"
                       FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,6,0,0"/>

            <!-- Your Device ID info -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="12,10" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="This PC's Device ID (Admin Device)"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="DeviceIdDisplay"
                               FontSize="13" FontFamily="Consolas"
                               Foreground="{DynamicResource AccentColor}"/>
                    <TextBlock Text="This ID is automatically assigned to the admin account."
                               FontSize="10"
                               Foreground="{DynamicResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Create button -->
        <Button Grid.Row="2"
                x:Name="CreateButton"
                Content="Create Administrator Account"
                Height="42"
                Margin="0,20,0,0"
                Background="{DynamicResource AccentColor}"
                Foreground="White"
                FontSize="14" FontWeight="SemiBold"
                FontFamily="Segoe UI"
                BorderThickness="0"
                Cursor="Hand"
                Click="CreateButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
