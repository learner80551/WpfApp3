<Window x:Class="WpfApp3.UI.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navlan — Login"
        Height="560" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main content -->
        <StackPanel VerticalAlignment="Center" Margin="48,32,48,24">

            <!-- Logo / Branding -->
            <Image Source="/navlan_logo.png"
                   Width="64" Height="64"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,0,0,12"/>

            <TextBlock Text="NAVLAN"
                       FontSize="26" FontWeight="Bold"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource AccentColor}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"/>

            <TextBlock Text="Secure LAN File Transfer"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource SecondaryText}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,32"/>

            <!-- Device ID (read-only) -->
            <TextBlock Text="Device ID"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <Border Background="{DynamicResource InputBackground}"
                    BorderBrush="{DynamicResource InputBorder}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="12,8" Margin="0,0,0,16">
                <TextBlock x:Name="DeviceIdText"
                           FontSize="12" FontFamily="Consolas"
                           Foreground="{DynamicResource SecondaryText}"/>
            </Border>

            <!-- Username -->
            <TextBlock Text="Username"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox"
                     FontSize="14" FontFamily="Segoe UI"
                     Background="{DynamicResource InputBackground}"
                     Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"
                     BorderThickness="1"
                     Padding="12,8"
                     Margin="0,0,0,12"
                     KeyDown="InputBox_KeyDown"/>

            <!-- Password -->
            <TextBlock Text="Password"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource SecondaryText}"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         FontSize="14" FontFamily="Segoe UI"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1"
                         Padding="12,8"
                         Margin="0,0,0,4"
                         KeyDown="InputBox_KeyDown"/>

            <!-- Error message -->
            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource DangerColor}"
                       FontSize="12" FontFamily="Segoe UI"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Margin="0,4,0,0"/>

            <!-- Login button -->
            <Button x:Name="LoginButton"
                    Content="Login"
                    Height="40"
                    Margin="0,20,0,0"
                    Background="{DynamicResource AccentColor}"
                    Foreground="White"
                    FontSize="14" FontWeight="SemiBold"
                    FontFamily="Segoe UI"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Theme toggle + version in footer -->
        <DockPanel Grid.Row="1" Margin="16,0,16,12">
            <TextBlock Text="v1.0" FontSize="10"
                       Foreground="{DynamicResource SecondaryText}"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"/>
            <ToggleButton x:Name="ThemeToggleBtn"
                          Content="☀ Light Mode"
                          IsChecked="False"
                          FontSize="11" FontFamily="Segoe UI"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource SecondaryText}"
                          Cursor="Hand"
                          Checked="ThemeToggle_Changed"
                          Unchecked="ThemeToggle_Changed"/>
        </DockPanel>
    </Grid>
</Window>
