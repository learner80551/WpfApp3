{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "WpfApp3 - Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/WpfApp3.csproj",
            "launchConfigurationId": "WpfApp3"
        }
    ]
}