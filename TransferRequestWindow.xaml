<Window x:Class="WpfApp3.TransferRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navlan – Incoming File"
        Height="340"
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#E8ECEC">

    <Window.Resources>
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo small -->
        <Image Grid.Row="0"
               Source="navlan_logo.png"
               Width="60"
               HorizontalAlignment="Left"
               RenderOptions.BitmapScalingMode="HighQuality"
               Margin="0,0,0,16"/>

        <!-- Title -->
        <TextBlock Grid.Row="1"
                   Text="Incoming File Request"
                   FontSize="18"
                   FontWeight="Bold"
                   FontFamily="Segoe UI"
                   Foreground="#1C2B30"
                   Margin="0,0,0,16"/>

        <!-- Info -->
        <Border Grid.Row="2"
                Background="#E2E6E7"
                BorderBrush="#C9D0D2"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="A device wants to send you a file:"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#4A6570"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="SenderText"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1C2B30"
                           Margin="0,3"/>

                <TextBlock x:Name="FileNameText"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="#1C2B30"
                           Margin="0,3"/>

                <TextBlock x:Name="FileSizeText"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#4A6570"
                           Margin="0,3"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="Reject"
                    Background="#C9D0D2"
                    Foreground="#1C2B30"
                    Width="110"
                    Height="38"
                    Margin="0,0,10,0"
                    Style="{StaticResource PillButton}"
                    Click="RejectButton_Click"/>

            <Button Content="Accept"
                    Background="#2C3E50"
                    Foreground="White"
                    Width="110"
                    Height="38"
                    Style="{StaticResource PillButton}"
                    Click="AcceptButton_Click"/>

        </StackPanel>
    </Grid>

</Window>