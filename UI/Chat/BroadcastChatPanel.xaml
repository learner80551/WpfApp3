<UserControl x:Class="WpfApp3.UI.Chat.BroadcastChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="💬 Broadcast Chat"
                       FontSize="13" FontWeight="SemiBold"
                       FontFamily="Segoe UI"
                       Foreground="{DynamicResource PrimaryText}"/>
        </Border>

        <!-- Message list -->
        <ScrollViewer Grid.Row="1"
                      x:Name="MessagesScroll"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0">
            <ItemsControl x:Name="MessagesList"
                          Padding="8,8,8,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="10,8"
                                CornerRadius="8"
                                Background="{DynamicResource ChatBubbleOther}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding SenderUsername}"
                                               FontWeight="SemiBold" FontSize="12"
                                               FontFamily="Segoe UI"
                                               Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="{Binding SenderDeviceId}"
                                               FontSize="10" Margin="6,1,0,0"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding TimeDisplay}"
                                               DockPanel.Dock="Right"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Bottom"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Text}"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Foreground="{DynamicResource PrimaryText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input area -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="0,1,0,0"
                Padding="8">
            <DockPanel>
                <Button x:Name="SendChatBtn"
                        Content="Send"
                        DockPanel.Dock="Right"
                        Width="60" Height="34"
                        Margin="6,0,0,0"
                        Background="{DynamicResource AccentColor}"
                        Foreground="White"
                        FontSize="12" FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        BorderThickness="0" Cursor="Hand"
                        Click="SendChatBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBox x:Name="ChatInputBox"
                         FontSize="12" FontFamily="Segoe UI"
                         Background="{DynamicResource InputBackground}"
                         Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"
                         BorderThickness="1"
                         Padding="8,6"
                         AcceptsReturn="False"
                         VerticalContentAlignment="Center"
                         KeyDown="ChatInputBox_KeyDown"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
